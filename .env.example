# Copy to .env and replace all CHANGE_ME values before startup.
DATABASE_PASSWORD=CHANGE_ME_database_password
RABBITMQ_PASSWORD=CHANGE_ME_broker_password
CHAOS_ADMIN_PASSWORD=CHANGE_ME_admin_password
CHAOS_ADMIN_USER=admin
DEMO_ALLOW_DEFECTS=false
# Optional OpenAI-compatible provider, including an Ollama /v1 endpoint reachable by API.
CHAOS_AI_BASE_URL=
CHAOS_AI_API_KEY=
CHAOS_AI_MODEL=
